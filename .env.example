# Copia este archivo como .env.local para probar en tu computadora,
# y agrega las mismas variables en Vercel (Settings → Environment Variables)
# antes de desplegar.

# --- Generador de sesiones STEAM (Gemini) ---
# Se usa solo en el servidor (api/generate-session.js), nunca en el navegador.
GEMINI_API_KEY=tu-clave-de-gemini-aqui

# --- Supabase (registro real de docentes) ---
# VITE_ prefijo = se usa en el navegador, es la clave pública "anon"
# (segura de exponer: solo permite insertar, no leer, según supabase-schema.sql)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# --- Panel de administración (/?admin=1) ---
# Estas dos NO llevan prefijo VITE_ porque solo se usan en el servidor
# (api/list-docentes.js) y deben mantenerse secretas.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta-aqui
ADMIN_SECRET=elige-una-clave-para-entrar-al-panel
