# Copia este archivo como .env.local para probar en tu computadora,
# y agrega las mismas variables en Vercel (Settings → Environment Variables)
# antes de desplegar.
#
# NUNCA escribas valores reales en este archivo: está versionado en Git.

# --- Generador con IA (Gemini) ---------------------------------------------
# Solo se usan en el servidor (api/*), nunca llegan al navegador.

GEMINI_API_KEY=tu-clave-de-gemini-aqui

# Modelo de Gemini a utilizar.
# Si se deja vacío, la aplicación usa "gemini-3.6-flash", que es un modelo
# válido y estable de la API (verificado el 2026-09-03 en
# https://ai.google.dev/gemini-api/docs/models). Aun así conviene fijarlo de
# forma explícita para controlar coste y comportamiento al cambiar de versión.
GEMINI_MAIN_MODEL=gemini-3.6-flash

# --- Supabase: navegador ----------------------------------------------------
# El prefijo VITE_ hace que la variable se incruste en el bundle del navegador.
# Es correcto para la URL y la clave pública; NUNCA para una clave secreta.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase renombró las claves públicas: las nuevas son "Publishable"
# (sb_publishable_...) y las antiguas "anon". La aplicación acepta ambas.
# Define al menos una de las dos.
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable-aqui
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# --- Supabase: servidor -----------------------------------------------------
# Sin prefijo VITE_: se quedan en el servidor. Se usan como respaldo de las
# anteriores y para el panel de administración.

SUPABASE_URL=https://tu-proyecto.supabase.co

# ⚠️ SECRETA. Omite RLS por completo. Solo se usa en api/list-docentes.js.
# Si se filtra, expone los datos de todos los docentes.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta-aqui

# --- Panel de administración (/?admin=1) ------------------------------------
# ⚠️ SECRETA. Desde el Bloque B viaja en la cabecera Authorization: Bearer,
# nunca en la URL. Usa una cadena larga y aleatoria, no una palabra.
# Sustituto por roles reales pendiente (Admin V2).
ADMIN_SECRET=usa-una-cadena-larga-y-aleatoria
